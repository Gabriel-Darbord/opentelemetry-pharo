"
I am responsible for processing and handling `OTSpan`s generated by an application.
I receive spans as they are created and am responsible for applying various processing steps to them.
These steps may include filtering, sampling, enriching, and forwarding to exporters.
Spans are processed in real time, providing immediate feedback and insight into application behavior.

By implementing custom SpanProcessor classes, developers can tailor span processing behavior to meet specific use cases and requirements.
"
Class {
	#name : 'OTSpanProcessor',
	#superclass : 'Object',
	#classVars : [
		'Current'
	],
	#category : 'OpenTelemetry-Exporters',
	#package : 'OpenTelemetry-Exporters'
}

{ #category : 'private' }
OTSpanProcessor class >> batchSpanProcessorExportTimeoutMillis [

	^ self
		nonNegativeIntegerEnvironmentValueAt: 'OTEL_BSP_EXPORT_TIMEOUT'
		default: self defaultBatchSpanProcessorExportTimeoutMillis
]

{ #category : 'private' }
OTSpanProcessor class >> batchSpanProcessorMaxExportBatchSizeForQueueSize: maxQueueSize [

	| rawValue parsed |
	rawValue := self environmentValueAt: 'OTEL_BSP_MAX_EXPORT_BATCH_SIZE'.
	parsed := rawValue
		ifNil: [ self defaultBatchSpanProcessorMaxExportBatchSize ]
		ifNotNil: [
			(self strictPositiveIntegerFrom: rawValue)
				ifNil: [
					self
						noteInvalidEnvironmentValue: rawValue
						forVariable: 'OTEL_BSP_MAX_EXPORT_BATCH_SIZE'.
					self defaultBatchSpanProcessorMaxExportBatchSize ]
				ifNotNil: [ :value | value ] ].
	^ parsed min: maxQueueSize
]

{ #category : 'private' }
OTSpanProcessor class >> batchSpanProcessorMaxQueueSize [

	^ self
		positiveIntegerEnvironmentValueAt: 'OTEL_BSP_MAX_QUEUE_SIZE'
		default: self defaultBatchSpanProcessorMaxQueueSize
]

{ #category : 'private' }
OTSpanProcessor class >> batchSpanProcessorScheduledDelayMillis [

	^ self
		nonNegativeIntegerEnvironmentValueAt: 'OTEL_BSP_SCHEDULE_DELAY'
		default: self defaultBatchSpanProcessorScheduledDelayMillis
]

{ #category : 'instance creation' }
OTSpanProcessor class >> batchSpanProcessorWithExporter: anExporter [
	"Apply BSP env sizing to one concrete exporter instance."

	| maxExportBatchSize maxQueueSize processor |
	processor := OTBatchSpanProcessor new exporter: anExporter.
	maxQueueSize := self batchSpanProcessorMaxQueueSize.
	maxExportBatchSize := self batchSpanProcessorMaxExportBatchSizeForQueueSize: maxQueueSize.
	processor
		maxQueueSize: maxQueueSize;
		batchSize: maxExportBatchSize;
		scheduledDelayMillis: self batchSpanProcessorScheduledDelayMillis;
		exportTimeoutMillis: self batchSpanProcessorExportTimeoutMillis.
	^ processor
]

{ #category : 'instance creation' }
OTSpanProcessor class >> beCurrent [

	<script>
	self isAbstract
		ifTrue: [ Error signal: self name , ' is abstract' ]
		ifFalse: [
			^ self == Current class
				  ifTrue: [ Current ]
				  ifFalse: [
					  Current ifNotNil: [ Current flush ].
					  Current := self new ] ]
]

{ #category : 'accessing' }
OTSpanProcessor class >> current [

	^ Current ifNil: [ Current := self readConfiguration ]
]

{ #category : 'accessing' }
OTSpanProcessor class >> current: aSpanProcessor [

	Current := aSpanProcessor
]

{ #category : 'instance creation' }
OTSpanProcessor class >> configuredProcessors [

	^ OTSpanExporter current componentExporters
		collect: [ :each | self processorForExporter: each ]
]

{ #category : 'instance creation' }
OTSpanProcessor class >> defaultBatchSpanProcessorExportTimeoutMillis [

	^ 30000
]

{ #category : 'instance creation' }
OTSpanProcessor class >> defaultBatchSpanProcessorMaxExportBatchSize [

	^ 512
]

{ #category : 'instance creation' }
OTSpanProcessor class >> defaultBatchSpanProcessorMaxQueueSize [

	^ 2048
]

{ #category : 'instance creation' }
OTSpanProcessor class >> defaultBatchSpanProcessorScheduledDelayMillis [

	^ 5000
]

{ #category : 'private - logging' }
OTSpanProcessor class >> defaultConfigurationWarningSink [

	^ OTDiagnosticLogger defaultWarningSink
]

{ #category : 'private' }
OTSpanProcessor class >> environmentValueAt: aString [

	^ OTConfigurationSource environmentValueAt: aString
]

{ #category : 'private - logging' }
OTSpanProcessor class >> configurationWarningSink [

	^ OTClassStateStore
		valueAt: #otConfigurationWarningSink
		forClass: self
		ifAbsent: [ self defaultConfigurationWarningSink ]
]

{ #category : 'private - logging' }
OTSpanProcessor class >> configurationWarningSink: aBlock [

	aBlock
		ifNil: [
			OTClassStateStore
				removeValueAt: #otConfigurationWarningSink
				forClass: self
				ifAbsent: [  ] ]
		ifNotNil: [
			OTClassStateStore
				valueAt: #otConfigurationWarningSink
				forClass: self
				put: aBlock ].
	^ self configurationWarningSink
]

{ #category : 'processing' }
OTSpanProcessor class >> flush [

	<script>
	^ Current ifNil: [ false ] ifNotNil: [ Current flush ]
]

{ #category : 'processing' }
OTSpanProcessor class >> forceFlush [

	<script>
	^ Current ifNil: [ false ] ifNotNil: [ Current forceFlush ]
]

{ #category : 'testing' }
OTSpanProcessor class >> isAbstract [

	^ self == OTSpanProcessor
]

{ #category : 'private - lifecycle' }
OTSpanProcessor class >> isShutdown: aProcessor [

	^ (self lifecycleStateByProcessor at: aProcessor ifAbsent: [ false ]) = true
]

{ #category : 'private - lifecycle' }
OTSpanProcessor class >> lifecycleStateByProcessor [

	^ OTClassStateStore
		valueAt: #otLifecycleStateByProcessor
		forClass: self
		ifAbsent: [
			| states |
			states := WeakIdentityKeyDictionary new.
			OTClassStateStore
				valueAt: #otLifecycleStateByProcessor
				forClass: self
				put: states.
			states ]
]

{ #category : 'private - lifecycle' }
OTSpanProcessor class >> markShutdown: aProcessor [

	self lifecycleStateByProcessor at: aProcessor put: true.
	^ aProcessor
]

{ #category : 'private - logging' }
OTSpanProcessor class >> noteInvalidEnvironmentValue: aValue forVariable: aString [

	self configurationWarningSink value:
		'OpenTelemetry batch span processor configuration was invalid and has been ignored for '
			, aString printString
			, ': '
			, aValue printString
]

{ #category : 'private' }
OTSpanProcessor class >> nonNegativeIntegerEnvironmentValueAt: aString default: aDefaultValue [

	| rawValue parsed |
	rawValue := self environmentValueAt: aString.
	rawValue ifNil: [ ^ aDefaultValue ].
	parsed := self strictNonNegativeIntegerFrom: rawValue.
	parsed ifNil: [
		self noteInvalidEnvironmentValue: rawValue forVariable: aString.
		^ aDefaultValue ].
	^ parsed
]

{ #category : 'private' }
OTSpanProcessor class >> positiveIntegerEnvironmentValueAt: aString default: aDefaultValue [

	| rawValue parsed |
	rawValue := self environmentValueAt: aString.
	rawValue ifNil: [ ^ aDefaultValue ].
	parsed := self strictPositiveIntegerFrom: rawValue.
	parsed ifNil: [
		self noteInvalidEnvironmentValue: rawValue forVariable: aString.
		^ aDefaultValue ].
	^ parsed
]

{ #category : 'instance creation' }
OTSpanProcessor class >> processorForExporter: anExporter [

	anExporter class == OTConsoleSpanExporter ifTrue: [
		^ OTSimpleSpanProcessor new exporter: anExporter ].
	^ self batchSpanProcessorWithExporter: anExporter
]

{ #category : 'instance creation' }
OTSpanProcessor class >> readConfiguration [

	| processors |
	processors := self configuredProcessors.
	^ processors size = 1
		ifTrue: [ processors first ]
		ifFalse: [ OTCompositeSpanProcessor withAll: processors ]
]

{ #category : 'class initialization' }
OTSpanProcessor class >> reset [

	self shutdown.
	self resetLifecycleState.
	OTConfigurationSource reset.
	Current := nil
]

{ #category : 'private - lifecycle' }
OTSpanProcessor class >> resetLifecycleState [

	OTClassStateStore
		removeValueAt: #otLifecycleStateByProcessor
		forClass: self
		ifAbsent: [  ]
]

{ #category : 'private' }
OTSpanProcessor class >> strictNonNegativeIntegerFrom: aString [

	| stream value |
	stream := aString trimBoth readStream.
	stream atEnd ifTrue: [ ^ nil ].
	value := [ Integer readFrom: stream ] on: Error do: [ ^ nil ].
	stream atEnd ifFalse: [ ^ nil ].
	value >= 0 ifFalse: [ ^ nil ].
	^ value
]

{ #category : 'processing' }
OTSpanProcessor class >> shutdown [

	<script>
	^ Current ifNil: [ false ] ifNotNil: [ Current shutdown ]
]

{ #category : 'private' }
OTSpanProcessor class >> strictPositiveIntegerFrom: aString [

	| stream value |
	stream := aString trimBoth readStream.
	stream atEnd ifTrue: [ ^ nil ].
	value := [ Integer readFrom: stream ] on: Error do: [ ^ nil ].
	stream atEnd ifFalse: [ ^ nil ].
	value > 0 ifFalse: [ ^ nil ].
	^ value
]

{ #category : 'accessing' }
OTSpanProcessor >> beCurrent [

	^ Current := self
]

{ #category : 'accessing' }
OTSpanProcessor >> componentProcessors [

	^ { self }
]

{ #category : 'processing' }
OTSpanProcessor >> flush [
	"Redefined by subclasses to terminate current span processing and forward to exporter."
]

{ #category : 'processing' }
OTSpanProcessor >> forceFlush [

	self isShutdown ifTrue: [ ^ false ].
	^ self flush
]

{ #category : 'testing' }
OTSpanProcessor >> isShutdown [

	^ self class isShutdown: self
]

{ #category : 'private - lifecycle' }
OTSpanProcessor >> markShutdown [

	self class markShutdown: self.
	^ self
]

{ #category : 'processing' }
OTSpanProcessor >> onEnd: aSpan [
	"Compatibility hook for processors that still implement completed-span processing via #process:."

	^ self process: aSpan
]

{ #category : 'processing' }
OTSpanProcessor >> onEnding: aSpan [
	"Default no-op lifecycle callback for spans that are about to end."
]

{ #category : 'processing' }
OTSpanProcessor >> onStart: aSpan parentContext: aContext [
	"Default no-op lifecycle callback for started spans."
]

{ #category : 'processing' }
OTSpanProcessor >> process: span [
	"Export the span and return true if it was accepted"

	self subclassResponsibility
]

{ #category : 'testing' }
OTSpanProcessor >> shouldExport: aSpan [

	^ aSpan spanContext isSampled
]

{ #category : 'processing' }
OTSpanProcessor >> shutdown [

	| flushed |
	self isShutdown ifTrue: [ ^ false ].
	flushed := self forceFlush.
	self markShutdown.
	^ flushed
]
