"
I am responsible for processing and handling `OTSpan`s generated by an application.
I receive spans as they are created and am responsible for applying various processing steps to them.
These steps may include filtering, sampling, enriching, and forwarding to exporters.
Spans are processed in real time, providing immediate feedback and insight into application behavior.

By implementing custom SpanProcessor classes, developers can tailor span processing behavior to meet specific use cases and requirements.
"
Class {
	#name : 'OTSpanProcessor',
	#superclass : 'Object',
	#classVars : [
		'Current'
	],
	#category : 'OpenTelemetry-Traces',
	#package : 'OpenTelemetry-Traces'
}

{ #category : 'private' }
OTSpanProcessor class >> batchSpanProcessorExportTimeoutMillis [

	^ self nonNegativeIntegerEnvironmentValueAt: 'OTEL_BSP_EXPORT_TIMEOUT' default: self defaultBatchSpanProcessorExportTimeoutMillis
]

{ #category : 'private' }
OTSpanProcessor class >> batchSpanProcessorMaxExportBatchSizeForQueueSize: maxQueueSize [

	| rawValue parsed |
	rawValue := self environmentValueAt: 'OTEL_BSP_MAX_EXPORT_BATCH_SIZE'.
	parsed := rawValue ifNil: [ self defaultBatchSpanProcessorMaxExportBatchSize ] ifNotNil: [
			          (self strictPositiveIntegerFrom: rawValue)
				          ifNil: [
						          self noteInvalidEnvironmentValue: rawValue forVariable: 'OTEL_BSP_MAX_EXPORT_BATCH_SIZE'.
						          self defaultBatchSpanProcessorMaxExportBatchSize ]
				          ifNotNil: [ :value | value ] ].
	^ parsed min: maxQueueSize
]

{ #category : 'private' }
OTSpanProcessor class >> batchSpanProcessorMaxQueueSize [

	^ self positiveIntegerEnvironmentValueAt: 'OTEL_BSP_MAX_QUEUE_SIZE' default: self defaultBatchSpanProcessorMaxQueueSize
]

{ #category : 'private' }
OTSpanProcessor class >> batchSpanProcessorScheduledDelayMillis [

	^ self
		  nonNegativeIntegerEnvironmentValueAt: 'OTEL_BSP_SCHEDULE_DELAY'
		  default: self defaultBatchSpanProcessorScheduledDelayMillis
]

{ #category : 'instance creation' }
OTSpanProcessor class >> batchSpanProcessorWithExporter: anExporter [
	"Apply BSP env sizing to one concrete exporter instance."

	| maxExportBatchSize maxQueueSize processor |
	processor := OTBatchSpanProcessor new exporter: anExporter.
	maxQueueSize := self batchSpanProcessorMaxQueueSize.
	maxExportBatchSize := self batchSpanProcessorMaxExportBatchSizeForQueueSize: maxQueueSize.
	processor
		maxQueueSize: maxQueueSize;
		batchSize: maxExportBatchSize;
		scheduledDelayMillis: self batchSpanProcessorScheduledDelayMillis;
		exportTimeoutMillis: self batchSpanProcessorExportTimeoutMillis.
	^ processor
]

{ #category : 'instance creation' }
OTSpanProcessor class >> beCurrent [

	<script>
	self isAbstract
		ifTrue: [ Error signal: self name , ' is abstract' ]
		ifFalse: [
				^ self == Current class
					  ifTrue: [ Current ]
					  ifFalse: [
							  Current ifNotNil: [ Current flush ].
							  Current := self new.
							  OTTracerProvider invalidateCurrent.
							  Current ] ]
]

{ #category : 'private - lifecycle' }
OTSpanProcessor class >> beginShutdown: aProcessor [

	^ self lifecycleStateLock critical: [
			  | state |
			  state := self lifecycleStateByProcessor at: aProcessor ifAbsent: [ nil ].
			  (state = #stopping or: [ state = #shutdown or: [ state = true ] ])
				  ifTrue: [ false ]
				  ifFalse: [
						  self lifecycleStateByProcessor at: aProcessor put: #stopping.
						  true ] ]
]

{ #category : 'private' }
OTSpanProcessor class >> configurationSourceClass [

	^ self environment at: #OTConfigurationSource ifAbsent: [ nil ]
]

{ #category : 'private - logging' }
OTSpanProcessor class >> configurationWarningOwner [

	self isAbstract ifTrue: [ ^ self ].
	^ self superclass configurationWarningOwner
]

{ #category : 'private - logging' }
OTSpanProcessor class >> configurationWarningSink [

	^ OTClassStateStore valueAt: #otConfigurationWarningSink forClass: self ifAbsent: [ self defaultConfigurationWarningSink ]
]

{ #category : 'private - logging' }
OTSpanProcessor class >> configurationWarningSink: aBlock [

	aBlock
		ifNil: [ OTClassStateStore removeValueAt: #otConfigurationWarningSink forClass: self ifAbsent: [ ] ]
		ifNotNil: [ OTClassStateStore valueAt: #otConfigurationWarningSink forClass: self put: aBlock ].
	^ self configurationWarningSink
]

{ #category : 'instance creation' }
OTSpanProcessor class >> configuredProcessors [

	| configurationSourceClass processors |
	configurationSourceClass := self configurationSourceClass.
	processors := configurationSourceClass ifNotNil: [ configurationSourceClass configuredTraceProcessors ].
	processors ifNotNil: [ ^ processors ].
	^ OTSpanExporter current componentExporters collect: [ :each | self processorForExporter: each ]
]

{ #category : 'accessing' }
OTSpanProcessor class >> current [

	^ Current ifNil: [ Current := self readConfiguration ]
]

{ #category : 'accessing' }
OTSpanProcessor class >> current: aSpanProcessor [

	Current := aSpanProcessor.
	OTTracerProvider invalidateCurrent
]

{ #category : 'accessing' }
OTSpanProcessor class >> currentIfSet [

	^ Current
]

{ #category : 'instance creation' }
OTSpanProcessor class >> defaultBatchSpanProcessorExportTimeoutMillis [

	^ 30000
]

{ #category : 'instance creation' }
OTSpanProcessor class >> defaultBatchSpanProcessorMaxExportBatchSize [

	^ 512
]

{ #category : 'instance creation' }
OTSpanProcessor class >> defaultBatchSpanProcessorMaxQueueSize [

	^ 2048
]

{ #category : 'instance creation' }
OTSpanProcessor class >> defaultBatchSpanProcessorScheduledDelayMillis [

	^ 5000
]

{ #category : 'private - logging' }
OTSpanProcessor class >> defaultConfigurationWarningSink [

	^ OTDiagnosticLogger defaultWarningSink
]

{ #category : 'private' }
OTSpanProcessor class >> environmentValueAt: aString [

	| configurationSourceClass |
	configurationSourceClass := self configurationSourceClass.
	^ configurationSourceClass ifNotNil: [ configurationSourceClass environmentValueAt: aString ]
]

{ #category : 'processing' }
OTSpanProcessor class >> flush [

	<script>
	^ Current ifNil: [ false ] ifNotNil: [ Current flush ]
]

{ #category : 'processing' }
OTSpanProcessor class >> forceFlush [

	<script>
	^ Current ifNil: [ false ] ifNotNil: [ Current forceFlush ]
]

{ #category : 'processing' }
OTSpanProcessor class >> forceFlushResult [

	<script>
	^ Current ifNil: [ OTLifecycleResult failure ] ifNotNil: [ Current forceFlushResult ]
]

{ #category : 'testing' }
OTSpanProcessor class >> isAbstract [

	^ self == OTSpanProcessor
]

{ #category : 'private - lifecycle' }
OTSpanProcessor class >> isShutdown: aProcessor [

	^ self lifecycleStateLock critical: [
			  | state |
			  state := self lifecycleStateByProcessor at: aProcessor ifAbsent: [ nil ].
			  state = #shutdown or: [ state = true ] ]
]

{ #category : 'private - lifecycle' }
OTSpanProcessor class >> isStopping: aProcessor [

	^ self lifecycleStateLock critical: [
			  | state |
			  state := self lifecycleStateByProcessor at: aProcessor ifAbsent: [ nil ].
			  state = #stopping or: [ state = #shutdown or: [ state = true ] ] ]
]

{ #category : 'private - lifecycle' }
OTSpanProcessor class >> lifecycleStateByProcessor [

	^ OTClassStateStore valueAt: #otLifecycleStateByProcessor forClass: self ifAbsentPut: [ WeakIdentityKeyDictionary new ]
]

{ #category : 'private - lifecycle' }
OTSpanProcessor class >> lifecycleStateLock [

	^ OTClassStateStore valueAt: #otLifecycleStateLock forClass: self ifAbsentPut: [ Semaphore forMutualExclusion ]
]

{ #category : 'private - lifecycle' }
OTSpanProcessor class >> markShutdown: aProcessor [

	self lifecycleStateLock critical: [ self lifecycleStateByProcessor at: aProcessor put: #shutdown ].
	^ aProcessor
]

{ #category : 'private' }
OTSpanProcessor class >> nonNegativeIntegerEnvironmentValueAt: aString default: aDefaultValue [

	| rawValue parsed |
	rawValue := self environmentValueAt: aString.
	rawValue ifNil: [ ^ aDefaultValue ].
	parsed := self strictNonNegativeIntegerFrom: rawValue.
	parsed ifNil: [
			self noteInvalidEnvironmentValue: rawValue forVariable: aString.
			^ aDefaultValue ].
	^ parsed
]

{ #category : 'private - logging' }
OTSpanProcessor class >> noteInvalidEnvironmentValue: aValue forVariable: aString [

	self configurationWarningSink value:
		'OpenTelemetry batch span processor configuration was invalid and has been ignored for ' , aString printString , ': '
		, aValue printString
]

{ #category : 'private - logging' }
OTSpanProcessor class >> noteInvalidRuntimeConfigurationValue: aValue forOperation: anOperationName [

	self configurationWarningSink value:
		'OpenTelemetry span processor configuration was invalid and has been ignored for ' , anOperationName asString printString , ': '
		, aValue printString
]

{ #category : 'private' }
OTSpanProcessor class >> positiveIntegerEnvironmentValueAt: aString default: aDefaultValue [

	| rawValue parsed |
	rawValue := self environmentValueAt: aString.
	rawValue ifNil: [ ^ aDefaultValue ].
	parsed := self strictPositiveIntegerFrom: rawValue.
	parsed ifNil: [
			self noteInvalidEnvironmentValue: rawValue forVariable: aString.
			^ aDefaultValue ].
	^ parsed
]

{ #category : 'instance creation' }
OTSpanProcessor class >> processorForExporter: anExporter [

	anExporter prefersSimpleSpanProcessor ifTrue: [ ^ OTSimpleSpanProcessor new exporter: anExporter ].
	^ self batchSpanProcessorWithExporter: anExporter
]

{ #category : 'instance creation' }
OTSpanProcessor class >> readConfiguration [

	| processors |
	processors := self configuredProcessors.
	^ processors size = 1
		  ifTrue: [ processors first ]
		  ifFalse: [ OTCompositeSpanProcessor withAll: processors ]
]

{ #category : 'class initialization' }
OTSpanProcessor class >> reset [

	| configurationSourceClass |
	self shutdown.
	self resetLifecycleState.
	configurationSourceClass := self configurationSourceClass.
	configurationSourceClass ifNotNil: [ configurationSourceClass reset ].
	Current := nil
]

{ #category : 'private - lifecycle' }
OTSpanProcessor class >> resetLifecycleState [

	OTClassStateStore removeValueAt: #otLifecycleStateByProcessor forClass: self ifAbsent: [ ]
]

{ #category : 'processing' }
OTSpanProcessor class >> shutdown [

	<script>
	^ Current ifNil: [ false ] ifNotNil: [ Current shutdown ]
]

{ #category : 'processing' }
OTSpanProcessor class >> shutdownResult [

	<script>
	^ Current ifNil: [ OTLifecycleResult failure ] ifNotNil: [ Current shutdownResult ]
]

{ #category : 'private' }
OTSpanProcessor class >> strictNonNegativeIntegerFrom: aString [

	| stream value |
	stream := aString trimBoth readStream.
	stream atEnd ifTrue: [ ^ nil ].
	value := [ Integer readFrom: stream ]
		         on: Error
		         do: [ ^ nil ].
	stream atEnd ifFalse: [ ^ nil ].
	value >= 0 ifFalse: [ ^ nil ].
	^ value
]

{ #category : 'private' }
OTSpanProcessor class >> strictPositiveIntegerFrom: aString [

	| stream value |
	stream := aString trimBoth readStream.
	stream atEnd ifTrue: [ ^ nil ].
	value := [ Integer readFrom: stream ]
		         on: Error
		         do: [ ^ nil ].
	stream atEnd ifFalse: [ ^ nil ].
	value > 0 ifFalse: [ ^ nil ].
	^ value
]

{ #category : 'actions' }
OTSpanProcessor >> beCurrent [

	Current := self.
	OTTracerProvider invalidateCurrent.
	self
]

{ #category : 'private - lifecycle' }
OTSpanProcessor >> beginShutdown [

	^ self class beginShutdown: self
]

{ #category : 'accessing' }
OTSpanProcessor >> componentProcessors [

	^ { self }
]

{ #category : 'private - logging' }
OTSpanProcessor >> configurationWarningOwner [

	^ self class configurationWarningOwner
]

{ #category : 'processing' }
OTSpanProcessor >> flush [
	"Redefined by subclasses to terminate current span processing and forward to exporter."

	^ true
]

{ #category : 'processing' }
OTSpanProcessor >> flushResult [

	^ OTLifecycleResult fromBoolean: self flush
]

{ #category : 'processing' }
OTSpanProcessor >> forceFlush [

	self isStopping ifTrue: [ ^ false ].
	^ self flush
]

{ #category : 'processing' }
OTSpanProcessor >> forceFlushResult [

	^ OTLifecycleResult fromBoolean: self forceFlush
]

{ #category : 'testing' }
OTSpanProcessor >> isShutdown [

	^ self class isShutdown: self
]

{ #category : 'testing' }
OTSpanProcessor >> isStopping [

	^ self class isStopping: self
]

{ #category : 'private - lifecycle' }
OTSpanProcessor >> markShutdown [

	self class markShutdown: self.
	^ self
]

{ #category : 'processing' }
OTSpanProcessor >> onEnd: aSpan [
	"Called synchronously after a span has ended. Concrete processors should treat the span as read-only at this point."

	self subclassResponsibility
]

{ #category : 'processing' }
OTSpanProcessor >> onEnding: aSpan [
	"Default no-op lifecycle callback for spans that are about to end."

	
]

{ #category : 'processing' }
OTSpanProcessor >> onStart: aSpan parentContext: aContext [
	"Default no-op lifecycle callback for started spans."

	
]

{ #category : 'testing' }
OTSpanProcessor >> shouldExport: aSpan [

	^ aSpan spanContext isSampled
]

{ #category : 'processing' }
OTSpanProcessor >> shutdown [

	| flushed |
	self beginShutdown ifFalse: [ ^ false ].
	flushed := self flush.
	self markShutdown.
	^ flushed
]

{ #category : 'processing' }
OTSpanProcessor >> shutdownResult [

	^ OTLifecycleResult fromBoolean: self shutdown
]

{ #category : 'private - configuration' }
OTSpanProcessor >> validatedExporterConfiguration: aSpanExporter forOperation: anOperationName [

	aSpanExporter ifNil: [ ^ nil ].
	(aSpanExporter isKindOf: OTSpanExporter) ifTrue: [ ^ aSpanExporter ].
	self configurationWarningOwner noteInvalidRuntimeConfigurationValue: aSpanExporter forOperation: anOperationName.
	^ nil
]
